<Window x:Class="ClaudeUsageWidget.TaskbarUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code Usage"
        Width="224"
        Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Border CornerRadius="4"
            Background="#FFD97757"
            BorderBrush="#FFAA4B30"
            BorderThickness="1"
            Padding="10,5"
            Cursor="Hand">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="3"
                    CornerRadius="2"
                    Background="#FF46241B" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CLAUDE"
                               Foreground="#FF241811"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="FiveHourText"
                               Text="  --%"
                               Foreground="#FF241811"
                               FontSize="11"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="5H " Foreground="#FF351D16" FontSize="10" FontWeight="Medium" />
                    <TextBlock x:Name="FiveHourSmallText" Text="--%" Foreground="#FF46241B" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  WRU " Foreground="#FF351D16" FontSize="10" FontWeight="Medium" />
                    <TextBlock x:Name="WeeklyText" Text="--%" Foreground="#FF46241B" FontSize="10" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
